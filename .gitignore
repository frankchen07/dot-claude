# Allowlist: only what travels between machines is tracked. Everything else in
# ~/.claude is machine-local, and anything new at the top level stays out.
/*
!/.claudeignore
!/.gitignore
!/CLAUDE.md
!/README.md
!/settings.json
!/setup.sh
!/agents/
!/docs/
!/mods/
!/read-once/
!/skills/

# Re-downloaded from the claude.ai account
skills/synced/

# read-once runtime artifacts (keep the scripts)
read-once/*
!read-once/hook.sh
!read-once/compact.sh

# Generated inside allowlisted directories
__pycache__/
mods/*/tsconfig.json
mods/*/.claude-plugin/types/

# Logs & local settings
*.jsonl
settings.local.json

# Secrets
.env
.env.*
!.env.example
